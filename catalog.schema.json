{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mildman1848/dispatcharr-plugins/main/catalog.schema.json",
  "title": "Mildman1848 Dispatcharr Plugin Registry Manifest",
  "type": "object",
  "required": ["registry_name", "plugins"],
  "additionalProperties": false,
  "properties": {
    "registry_name": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(?i)(official|dispatcharr plugins|dispatcharr repo|dispatcharr official)"}
    },
    "registry_url": {"type": "string", "format": "uri"},
    "root_url": {"type": "string", "format": "uri"},
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name", "latest_version", "latest_url"],
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "author": {"type": "string"},
          "maintainers": {"type": "array", "items": {"type": "string"}},
          "license": {"type": "string"},
          "deprecated": {"type": "boolean"},
          "repo_url": {"type": "string", "format": "uri"},
          "latest_version": {"type": "string", "minLength": 1},
          "manifest_url": {"type": "string"},
          "latest_url": {"type": "string", "format": "uri"},
          "latest_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "latest_size": {"type": "number", "minimum": 0},
          "icon_url": {"type": "string"},
          "min_dispatcharr_version": {"type": "string"},
          "max_dispatcharr_version": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  }
}
