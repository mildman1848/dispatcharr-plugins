{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mildman1848/dispatcharr-plugins/main/catalog.schema.json",
  "title": "Mildman1848 Dispatcharr Plugin Catalog",
  "type": "object",
  "required": ["schema_version", "publisher", "plugins"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "publisher": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"}
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "repository", "license", "release"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "format": "uri"},
          "license": {"type": "string", "minLength": 1},
          "dispatcharr": {"type": "object"},
          "upstream_projects": {"type": "array", "items": {"type": "string", "format": "uri"}},
          "release": {
            "type": "object",
            "required": ["tag_pattern", "asset_pattern", "checksum_asset"],
            "additionalProperties": false,
            "properties": {
              "tag_pattern": {"type": "string"},
              "asset_pattern": {"type": "string"},
              "checksum_asset": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
